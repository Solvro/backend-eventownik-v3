generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizerType {
  organizer
  superadmin
}

enum PermissionType {
  MANAGE_ALL
  MANAGE_EVENT
  MANAGE_FORM
  MANAGE_PARTICIPANT
  MANAGE_EMAIL
  MANAGE_SETTINGS
  MANAGE_TICKET
  SCAN_TICKET
}

enum LogTrigger {
  ADMIN
  PARTICIPANT
  SYSTEM
}

model Admin {
  uuid      String        @id @default(uuid()) @db.Uuid
  firstName String
  lastName  String
  password  String
  email     String        @unique
  type      OrganizerType @default(organizer)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  events             Event[]              @relation("Organizer")
  permissions        EventPermission[]
  refreshToken       RefreshToken[]
  passwordResetToken PasswordResetToken[]
  ticketCheckIns     TicketCheckIn[]

  @@map("Admins")
}

model EventPermission {
  uuid      String @id @default(uuid()) @db.Uuid
  eventUuid String @db.Uuid
  adminUuid String @db.Uuid

  permission PermissionType

  admin Admin @relation(fields: [adminUuid], references: [uuid], onDelete: Cascade)
  event Event @relation(fields: [eventUuid], references: [uuid], onDelete: Cascade)

  @@unique([eventUuid, adminUuid, permission])
  @@map("EventPermissions")
}

model Event {
  uuid              String    @id @default(uuid()) @db.Uuid
  name              String
  startDate         DateTime
  endDate           DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  slug              String    @unique
  isPublic          Boolean   @default(false)
  isVerified        Boolean   @default(false)
  isFeatured        Boolean   @default(false)
  participantsLimit Int?
  verifiedAt        DateTime?
  sentToBbiAt       DateTime?
  description       String?
  primaryColor      String?
  organizerName     String?
  photoKey          String?
  location          String?
  contactEmail      String?
  organizerUuid     String?   @db.Uuid
  registerFormUuid  String?   @db.Uuid

  organizerAdmin   Admin?            @relation("Organizer", fields: [organizerUuid], references: [uuid], onDelete: SetNull)
  registerForm     Form?             @relation("RegisterForm", fields: [registerFormUuid], references: [uuid], onDelete: SetNull)
  attributes       Attribute[]
  emails           EmailTemplate[]
  forms            Form[]            @relation("EventForms")
  adminPermissions EventPermission[]
  participants     Participant[]
  links            EventLink[]
  tickets          Ticket[]

  mobileApp           MobileApp?
  mobileSosContacts   MobileSosContact[]
  mobileFaqItems      MobileFaqItem[]
  mobileScheduleItems MobileScheduleItem[]
  mobileNotifications MobileNotification[]
  mobileProfiles      MobileProfile[]
  mobileChatRooms     MobileChatRoom[]
  mobileSwipes        MobileSwipe[]
  mobileBingoTasks    MobileBingoTask[]
  mobileBerealRounds  MobileBerealRound[]

  @@map("Events")
}

enum EventLinkType {
  general
  policy
}

model EventLink {
  uuid      String        @id @default(uuid()) @db.Uuid
  eventUuid String        @db.Uuid
  url       String
  type      EventLinkType
  label     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  event Event @relation(fields: [eventUuid], references: [uuid], onDelete: Cascade)

  @@map("EventsLinks")
}

enum AttributeType {
  text
  textArea
  number
  file
  drawing
  select
  block
  date
  time
  datetime
  multiSelect
  email
  tel
  color
  checkbox
}

model Attribute {
  uuid       String        @id @default(uuid()) @db.Uuid
  eventUuid  String        @db.Uuid
  type       AttributeType
  name       String
  order      Int
  showInList Boolean       @default(true)
  config     Json?         @default("{}")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sentToBbiAt DateTime?

  event                 Event                  @relation(fields: [eventUuid], references: [uuid], onDelete: Cascade)
  blocks                Block[]
  formDefinitions       FormDefinition[]
  participantAttributes ParticipantAttribute[]
  ticket                Ticket?
  ticketAttributes      TicketAttribute[]

  @@map("Attributes")
}

model Block {
  uuid          String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  capacity      Int?
  order         Int?
  name          String
  description   String?
  parentUuid    String?  @db.Uuid
  attributeUuid String?  @db.Uuid
  isRootBlock   Boolean  @default(false)

  parent         Block?          @relation("BlockToBlock", fields: [parentUuid], references: [uuid], onDelete: Cascade)
  children       Block[]         @relation("BlockToBlock")
  attribute      Attribute?      @relation(fields: [attributeUuid], references: [uuid], onDelete: Cascade)
  ticketCheckIns TicketCheckIn[]

  @@map("Blocks")
}

enum EmailTrigger {
  PARTICIPANT_REGISTERED
  PARTICIPANT_DELETED
  FORM_FILLED
  ATTRIBUTE_CHANGED
  MANUAL
}

model EmailTemplate {
  uuid          String       @id @default(uuid()) @db.Uuid
  name          String
  content       String
  schema        Json?
  trigger       EmailTrigger
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  triggerConfig Json?
  order         Int?
  eventUuid     String       @db.Uuid

  event             Event                    @relation(fields: [eventUuid], references: [uuid], onDelete: Cascade)
  participantEmails ParticipantEmailStatus[]
  participantForms  ParticipantFormLog[]

  @@map("EmailTemplates")
}

enum OpenCondition {
  ON_DATE
  MANUAL
}

model Form {
  uuid          String        @id @default(uuid()) @db.Uuid
  name          String
  isEditable    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  openDate      DateTime?
  closeDate     DateTime?
  description   String?
  eventUuid     String?       @db.Uuid
  isOpen        Boolean       @default(false)
  openCondition OpenCondition @default(MANUAL)
  order         Int?

  event            Event?               @relation("EventForms", fields: [eventUuid], references: [uuid], onDelete: Cascade)
  formDefinitions  FormDefinition[]
  participantForms ParticipantFormLog[]
  registerEvent    Event[]              @relation("RegisterForm")

  uploadedFiles UploadedFile[]

  @@map("Forms")
}

model UploadedFile {
  uuid         String    @id @default(uuid()) @db.Uuid
  fileKey      String
  originalName String
  mimeType     String
  size         Int
  formUuid     String    @db.Uuid
  sourceIp     String
  createdAt    DateTime  @default(now())
  claimedAt    DateTime?

  form Form @relation(fields: [formUuid], references: [uuid], onDelete: Cascade)

  @@index([claimedAt, createdAt])
  @@map("UploadedFiles")
}

model FormDefinition {
  uuid          String   @id @default(uuid()) @db.Uuid
  isRequired    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Int?
  attributeUuid String?  @db.Uuid
  formUuid      String?  @db.Uuid

  attribute Attribute? @relation(fields: [attributeUuid], references: [uuid], onDelete: Cascade)
  form      Form?      @relation(fields: [formUuid], references: [uuid], onDelete: Cascade)

  @@map("FormsDefinitions")
}

model Participant {
  uuid        String   @id @default(uuid()) @db.Uuid
  email       String
  eventUuid   String   @db.Uuid
  ticketToken String   @unique @default(dbgenerated("replace((gen_random_uuid())::text || (gen_random_uuid())::text, '-', '')"))
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event               Event                     @relation(fields: [eventUuid], references: [uuid], onDelete: Cascade)
  attributes          ParticipantAttribute[]
  emails              ParticipantEmailStatus[]
  attributeLogs       ParticipantAttributeLog[]
  participantFormLogs ParticipantFormLog[]
  ticketCheckIns      TicketCheckIn[]

  mobileProfile          MobileProfile?
  mobileOtpCodes         MobileOtpCode[]
  mobileChatMemberships  MobileChatMember[]
  mobileChatMessages     MobileChatMessage[]
  mobileSwipesSent       MobileSwipe[]           @relation("MobileSwipeFrom")
  mobileSwipesReceived   MobileSwipe[]           @relation("MobileSwipeTo")
  mobileBingoCompletions MobileBingoCompletion[]
  mobileBerealPosts      MobileBerealPost[]

  @@unique([email, eventUuid])
  @@map("Participants")
}

model ParticipantAttribute {
  uuid            String @id @default(uuid()) @db.Uuid
  participantUuid String @db.Uuid
  attributeUuid   String @db.Uuid
  value           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participant Participant @relation(fields: [participantUuid], references: [uuid], onDelete: Cascade)
  attribute   Attribute   @relation(fields: [attributeUuid], references: [uuid], onDelete: Cascade)

  @@unique([participantUuid, attributeUuid])
  @@map("ParticipantsAttributes")
}

enum EmailStatus {
  pending
  sent
  failed
}

model ParticipantEmailStatus {
  uuid            String      @id @default(uuid()) @db.Uuid
  status          EmailStatus
  sendAt          DateTime
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  sendBy          String?
  participantUuid String?     @db.Uuid
  emailUuid       String?     @db.Uuid

  participant Participant?   @relation(fields: [participantUuid], references: [uuid], onDelete: Cascade)
  email       EmailTemplate? @relation(fields: [emailUuid], references: [uuid], onDelete: Cascade)

  @@map("ParticipantsEmailStatuses")
}

model ParticipantFormLog {
  uuid            String    @id @default(uuid()) @db.Uuid
  participantUuid String    @db.Uuid
  formUuid        String    @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastOpenedAt    DateTime?
  lastSubmittedAt DateTime?
  emailUuid       String?   @db.Uuid

  participant Participant    @relation(fields: [participantUuid], references: [uuid], onDelete: Cascade)
  form        Form           @relation(fields: [formUuid], references: [uuid], onDelete: Cascade)
  email       EmailTemplate? @relation(fields: [emailUuid], references: [uuid], onDelete: SetNull)

  @@unique([participantUuid, formUuid])
  @@map("ParticipantsFormLogs")
}

model ParticipantAttributeLog {
  uuid            String     @id @default(uuid()) @db.Uuid
  participantUuid String     @db.Uuid
  triggeredBy     LogTrigger
  createdAt       DateTime   @default(now())
  triggeredUuid   String?    @db.Uuid
  attributeUuid   String?    @db.Uuid
  before          Json?
  after           Json?

  participant Participant @relation(fields: [participantUuid], references: [uuid], onDelete: Cascade)

  @@map("ParticipantsAttributesLogs")
}

enum TicketMode {
  EVENT
  BLOCK
}

model Ticket {
  uuid          String     @id @default(uuid()) @db.Uuid
  eventUuid     String     @db.Uuid
  attributeUuid String?    @unique @db.Uuid
  mode          TicketMode
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  event      Event             @relation(fields: [eventUuid], references: [uuid], onDelete: Cascade)
  attribute  Attribute?        @relation(fields: [attributeUuid], references: [uuid], onDelete: Cascade)
  attributes TicketAttribute[]
  checkIns   TicketCheckIn[]

  @@index([eventUuid])
  @@map("Tickets")
}

model TicketAttribute {
  uuid          String @id @default(uuid()) @db.Uuid
  ticketUuid    String @db.Uuid
  attributeUuid String @db.Uuid

  ticket    Ticket    @relation(fields: [ticketUuid], references: [uuid], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeUuid], references: [uuid], onDelete: Cascade)

  @@unique([ticketUuid, attributeUuid])
  @@map("TicketAttributes")
}

model TicketCheckIn {
  uuid                 String   @id @default(uuid()) @db.Uuid
  ticketUuid           String   @db.Uuid
  participantUuid      String   @db.Uuid
  blockUuid            String?  @db.Uuid
  confirmedAt          DateTime @default(now())
  confirmedByAdminUuid String?  @db.Uuid

  ticket      Ticket      @relation(fields: [ticketUuid], references: [uuid], onDelete: Cascade)
  participant Participant @relation(fields: [participantUuid], references: [uuid], onDelete: Cascade)
  block       Block?      @relation(fields: [blockUuid], references: [uuid], onDelete: Cascade)
  confirmedBy Admin?      @relation(fields: [confirmedByAdminUuid], references: [uuid], onDelete: SetNull)

  @@index([participantUuid])
  @@map("TicketCheckIns")
}

model RefreshToken {
  uuid      String   @id @default(uuid()) @db.Uuid
  adminUuid String   @db.Uuid
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  admin Admin @relation(fields: [adminUuid], references: [uuid], onDelete: Cascade)

  @@index(fields: [adminUuid])
  @@map("RefreshTokens")
}

model PasswordResetToken {
  uuid      String   @id @default(uuid()) @db.Uuid
  adminUuid String   @db.Uuid
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  admin Admin @relation(fields: [adminUuid], references: [uuid], onDelete: Cascade)

  @@map("PasswordResetTokens")
}

model AuditLog {
  uuid        String   @id @default(uuid()) @db.Uuid
  action      String
  entityType  String
  entityUuid  String?  @db.Uuid
  triggeredBy String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@map("AuditLogs")
}

// ---------------------------------------------------------------------------
// Mobile app (participant PWA)
// ---------------------------------------------------------------------------

model MobileApp {
  uuid            String   @id @default(uuid()) @db.Uuid
  eventUuid       String   @unique @db.Uuid
  isEnabled       Boolean  @default(false)
  welcomeMessage  String?
  sosEnabled      Boolean  @default(true)
  scheduleEnabled Boolean  @default(true)
  chatEnabled     Boolean  @default(true)
  tinderEnabled   Boolean  @default(true)
  bingoEnabled    Boolean  @default(true)
  berealEnabled   Boolean  @default(true)
  bingoSize       Int      @default(4)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event Event @relation(fields: [eventUuid], references: [uuid], onDelete: Cascade)

  @@map("MobileApps")
}

model MobileSosContact {
  uuid        String   @id @default(uuid()) @db.Uuid
  eventUuid   String   @db.Uuid
  label       String
  phone       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventUuid], references: [uuid], onDelete: Cascade)

  @@index([eventUuid])
  @@map("MobileSosContacts")
}

model MobileFaqItem {
  uuid      String   @id @default(uuid()) @db.Uuid
  eventUuid String   @db.Uuid
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventUuid], references: [uuid], onDelete: Cascade)

  @@index([eventUuid])
  @@map("MobileFaqItems")
}

model MobileScheduleItem {
  uuid        String    @id @default(uuid()) @db.Uuid
  eventUuid   String    @db.Uuid
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event Event @relation(fields: [eventUuid], references: [uuid], onDelete: Cascade)

  @@index([eventUuid, startsAt])
  @@map("MobileScheduleItems")
}

model MobileNotification {
  uuid               String   @id @default(uuid()) @db.Uuid
  seq                Int      @unique @default(autoincrement())
  eventUuid          String   @db.Uuid
  title              String
  body               String
  createdByAdminUuid String?  @db.Uuid
  createdAt          DateTime @default(now())

  event Event @relation(fields: [eventUuid], references: [uuid], onDelete: Cascade)

  @@index([eventUuid, seq])
  @@map("MobileNotifications")
}

model MobileProfile {
  uuid            String   @id @default(uuid()) @db.Uuid
  participantUuid String   @unique @db.Uuid
  eventUuid       String   @db.Uuid
  displayName     String
  bio             String?
  photoKey        String?
  tinderOptIn     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participant Participant @relation(fields: [participantUuid], references: [uuid], onDelete: Cascade)
  event       Event       @relation(fields: [eventUuid], references: [uuid], onDelete: Cascade)

  @@index([eventUuid])
  @@map("MobileProfiles")
}

model MobileOtpCode {
  uuid            String    @id @default(uuid()) @db.Uuid
  participantUuid String    @db.Uuid
  codeHash        String
  attempts        Int       @default(0)
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  participant Participant @relation(fields: [participantUuid], references: [uuid], onDelete: Cascade)

  @@index([participantUuid, createdAt])
  @@map("MobileOtpCodes")
}

enum MobileChatRoomType {
  EVENT
  DIRECT
}

model MobileChatRoom {
  uuid      String             @id @default(uuid()) @db.Uuid
  eventUuid String             @db.Uuid
  type      MobileChatRoomType
  // "EVENT" for the event-wide room, "<lowerUuid>:<higherUuid>" for a direct room
  key       String
  createdAt DateTime           @default(now())

  event    Event               @relation(fields: [eventUuid], references: [uuid], onDelete: Cascade)
  members  MobileChatMember[]
  messages MobileChatMessage[]

  @@unique([eventUuid, key])
  @@map("MobileChatRooms")
}

model MobileChatMember {
  uuid            String   @id @default(uuid()) @db.Uuid
  roomUuid        String   @db.Uuid
  participantUuid String   @db.Uuid
  lastReadSeq     Int      @default(0)
  createdAt       DateTime @default(now())

  room        MobileChatRoom @relation(fields: [roomUuid], references: [uuid], onDelete: Cascade)
  participant Participant    @relation(fields: [participantUuid], references: [uuid], onDelete: Cascade)

  @@unique([roomUuid, participantUuid])
  @@index([participantUuid])
  @@map("MobileChatMembers")
}

model MobileChatMessage {
  uuid                  String    @id @default(uuid()) @db.Uuid
  seq                   Int       @unique @default(autoincrement())
  roomUuid              String    @db.Uuid
  senderParticipantUuid String?   @db.Uuid
  senderAdminUuid       String?   @db.Uuid
  body                  String
  createdAt             DateTime  @default(now())
  deletedAt             DateTime?

  room   MobileChatRoom @relation(fields: [roomUuid], references: [uuid], onDelete: Cascade)
  sender Participant?   @relation(fields: [senderParticipantUuid], references: [uuid], onDelete: SetNull)

  @@index([roomUuid, seq])
  @@map("MobileChatMessages")
}

model MobileSwipe {
  uuid                String   @id @default(uuid()) @db.Uuid
  eventUuid           String   @db.Uuid
  fromParticipantUuid String   @db.Uuid
  toParticipantUuid   String   @db.Uuid
  liked               Boolean
  createdAt           DateTime @default(now())

  event Event       @relation(fields: [eventUuid], references: [uuid], onDelete: Cascade)
  from  Participant @relation("MobileSwipeFrom", fields: [fromParticipantUuid], references: [uuid], onDelete: Cascade)
  to    Participant @relation("MobileSwipeTo", fields: [toParticipantUuid], references: [uuid], onDelete: Cascade)

  @@unique([fromParticipantUuid, toParticipantUuid])
  @@index([toParticipantUuid, liked])
  @@index([eventUuid])
  @@map("MobileSwipes")
}

model MobileBingoTask {
  uuid      String   @id @default(uuid()) @db.Uuid
  eventUuid String   @db.Uuid
  text      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event       Event                   @relation(fields: [eventUuid], references: [uuid], onDelete: Cascade)
  completions MobileBingoCompletion[]

  @@index([eventUuid])
  @@map("MobileBingoTasks")
}

model MobileBingoCompletion {
  uuid            String   @id @default(uuid()) @db.Uuid
  taskUuid        String   @db.Uuid
  participantUuid String   @db.Uuid
  photoKey        String?
  createdAt       DateTime @default(now())

  task        MobileBingoTask @relation(fields: [taskUuid], references: [uuid], onDelete: Cascade)
  participant Participant     @relation(fields: [participantUuid], references: [uuid], onDelete: Cascade)

  @@unique([taskUuid, participantUuid])
  @@index([participantUuid])
  @@map("MobileBingoCompletions")
}

model MobileBerealRound {
  uuid      String   @id @default(uuid()) @db.Uuid
  eventUuid String   @db.Uuid
  prompt    String?
  startedAt DateTime @default(now())
  endsAt    DateTime
  createdAt DateTime @default(now())

  event Event              @relation(fields: [eventUuid], references: [uuid], onDelete: Cascade)
  posts MobileBerealPost[]

  @@index([eventUuid, startedAt])
  @@map("MobileBerealRounds")
}

model MobileBerealPost {
  uuid            String   @id @default(uuid()) @db.Uuid
  roundUuid       String   @db.Uuid
  participantUuid String   @db.Uuid
  photoKey        String
  selfieKey       String?
  caption         String?
  isLate          Boolean  @default(false)
  createdAt       DateTime @default(now())

  round       MobileBerealRound @relation(fields: [roundUuid], references: [uuid], onDelete: Cascade)
  participant Participant       @relation(fields: [participantUuid], references: [uuid], onDelete: Cascade)

  @@unique([roundUuid, participantUuid])
  @@index([participantUuid])
  @@map("MobileBerealPosts")
}
